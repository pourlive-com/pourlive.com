<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FAQs | Pour Live Private Bartending</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --night:#0E0D0C;
    --panel:#151311;
    --cream:#F6F0E6;
    --amber:#F2A33A;
    --line:#2A2724;
    --muted:#BDB5A8;
    --field:#3A3631;
  }

  * {
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
  }

  html {
    background:var(--night);
    margin:0;
    padding:0;
    width:100%;
  }

  body {
    margin:0;
    padding:0;
    width:100%;
    min-height:100%;
    background:var(--night);
    color:var(--cream);
    font-family:Inter,-apple-system,BlinkMacSystemFont,sans-serif;
    line-height:1.55;
    -webkit-text-size-adjust:100%;
    -webkit-overflow-scrolling:touch;
  }

  /* Navigation Bar Styles */
  .nav-bar {
    border-bottom: 1px solid var(--line);
    background: rgba(14, 13, 12, 0.95);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
  }

  .nav-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--cream);
  }

  .nav-brand .pour {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 28px;
    line-height: .82;
    letter-spacing: .03em;
  }

  .nav-brand .live {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .5em;
    color: var(--amber);
  }

  .nav-brand .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    display: inline-block;
  }

  .nav-links {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color .15s ease;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--amber);
  }

  .wrap {
    max-width:1080px;
    margin:0 auto;
    padding:36px 20px 60px;
  }

  .page-header {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }

  .page-header h1 {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 56px;
    letter-spacing: .02em;
    margin: 0 0 8px;
    color: var(--cream);
    line-height: 1.1;
  }

  .page-header p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    max-width: 60ch;
  }

  /* FAQ Accordion Styles */
  .faq-list {
    display: grid;
    gap: 14px;
    max-width: 820px;
  }

  details.faq-item {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    overflow: hidden;
    transition: border-color .15s ease;
  }

  details.faq-item[open] {
    border-color: var(--amber);
  }

  details.faq-item summary {
    padding: 20px 24px;
    font-size: 17px;
    font-weight: 600;
    color: var(--cream);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  details.faq-item summary::-webkit-details-marker {
    display: none;
  }

  details.faq-item summary::after {
    content: '+';
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 28px;
    line-height: 1;
    color: var(--amber);
    flex-shrink: 0;
  }

  details.faq-item[open] summary::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 24px 22px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
    border-top: 1px solid rgba(42, 39, 36, 0.6);
    padding-top: 14px;
  }

  .faq-answer p {
    margin: 0;
  }

  .cta-box {
    margin-top: 48px;
    max-width: 820px;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px;
    background: var(--panel);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .cta-box h2 {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 32px;
    letter-spacing: .02em;
    margin: 0 0 4px;
    color: var(--cream);
  }

  .cta-box p {
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--amber);
    color: var(--night);
    font: 700 15px Inter, sans-serif;
    text-decoration: none;
    transition: background .15s ease;
  }

  .btn:hover {
    background: #FFC06A;
  }

  /* Footer Styles */
  .foot {
    margin-top:56px;
    padding-top:28px;
    border-top:1px solid var(--line);
    display:flex;
    flex-wrap:wrap;
    gap:28px 48px;
    align-items:flex-start;
    justify-content:space-between;
  }

  .foot-brand {
    display:flex;
    align-items:center;
    gap:12px;
  }

  .foot-brand .pour {
    font-family:'Bebas Neue',Impact,sans-serif;
    font-size:44px;
    line-height:.82;
    letter-spacing:.03em;
  }

  .foot-brand .live {
    display:flex;
    align-items:center;
    gap:8px;
    font-weight:700;
    font-size:11px;
    letter-spacing:.55em;
    color:var(--amber);
    padding-left:2px;
  }

  .foot-brand .live i {
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--amber);
    display:inline-block;
  }

  .foot-cols {
    display:flex;
    flex-wrap:wrap;
    gap:28px 48px;
  }

  .foot h4 {
    margin:0 0 8px;
    font-size:14px;
    color:var(--amber);
  }

  .foot p,
  .foot a {
    margin:0 0 6px;
    font-size:14.5px;
    color:var(--cream);
    text-decoration:none;
    display:block;
  }

  .foot a:hover {
    color:var(--amber);
  }

  .legal {
    width:100%;
    margin-top:12px;
    font-size:12.5px;
    color:var(--muted);
  }

  @media (max-width:768px) {
    .nav-links {
      gap: 16px;
      font-size: 13px;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
    .wrap {
      padding:24px 16px 40px;
    }
    .page-header h1 {
      font-size: 40px;
    }
    details.faq-item summary {
      padding: 16px 18px;
      font-size: 16px;
    }
    .faq-answer {
      padding: 0 18px 18px;
    }
    .foot {
      margin-top:40px;
      padding-top:20px;
      gap:24px;
    }
  }
</style>
</head>

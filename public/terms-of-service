<div class="wrap" id="terms-container">

  <!-- HEADER -->
  <header class="hero">
    <div class="mark">
      <svg width="86" height="86" viewBox="0 0 100 100" role="img" aria-label="Pour Live icon">
        <path d="M50 8 C46 15 41 21 41 27 A9 9 0 0 0 59 27 C59 21 54 15 50 8 Z" fill="#F2A33A"/>
        <path d="M18 44 L82 44 Q78 66 50 68 Q22 66 18 44 Z" fill="none" stroke="#F6F0E6" stroke-width="5" stroke-linejoin="round"/>

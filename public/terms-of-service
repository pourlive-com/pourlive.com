<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Terms of Service | Pour Live Private Bartending</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --night: #0E0D0C;
  --panel: #151311;
  --cream: #F6F0E6;
  --amber: #F2A33A;
  --line: #2A2724;
  --muted: #BDB5A8;
  --field: #3A3631;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

/* STABLE STATIC SCROLLBOUNDS (NO DYNAMIC HEIGHT JITTER) */
html, body {
  background: var(--night);
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
  height: auto !important;
  overflow-y: visible !important;
  -webkit-overflow-scrolling: touch;
}

body {
  color: var(--cream);
  font-family: Inter, Arial, sans-serif;
  line-height: 1.65;
  -webkit-text-size-adjust: 100%;
}

/* Navigation Bar Styles */
.nav-bar {
  border-bottom: 1px solid var(--line);
  background: rgba(14, 13, 12, 0.95);
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(8px);
}

.nav-wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--cream);
}

.nav-brand .pour {
  font-family: 'Bebas Neue', Impact, sans-serif;
  font-size: 28px;
  line-height: .82;
  letter-spacing: .03em;
}

.nav-brand .live {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  font-size: 11px;
  letter-spacing: .5em;
  color: var(--amber);
}

.nav-brand .live i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber);
  display: inline-block;
}

.nav-links {
  display: flex;
  gap: 20px;
  align-items: center;
}

.nav-links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color .15s ease;
}

.nav-links a:hover, .nav-links a.active {
  color: var(--amber);
}

#terms-container {
  max-width: 1080px;
  margin: 0 auto;
  padding: 40px 24px 60px;
  display: block;
  width: 100%;
  min-height: max-content;
}

h1, h2, h3, .pour {
  font-family: "Bebas Neue", Impact, sans-serif;
  font-weight: 400;
}

a {
  color: var(--amber);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* HEADER */

.hero {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 28px;
  padding-bottom: 36px;
  border-bottom: 1px solid var(--line);
}

.mark {
  display: flex;
  align-items: center;
  gap: 18px;
}

.pour {
  font-size: 96px;
  line-height: .82;
  letter-spacing: .03em;
}

.live {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 17px;
  letter-spacing: .6em;
  color: var(--amber);
  padding-left: 4px;
}

.live i {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--amber);
  display: inline-block;
}

.pitch {
  flex: 1 1 320px;
}

.pitch h1 {
  font-size: 48px;
  line-height: 1;
  letter-spacing: .02em;
  margin: 0 0 12px;
}

.pitch p {
  color: var(--muted);
  margin: 0;
  max-width: 60ch;
  font-size: 15px;
}

.back {
  display: inline-flex;
  align-items: center;
  margin-top: 25px;
  font-weight: 700;
  font-size: 14px;
}

/* INTRO */

.intro {
  margin-top: 30px;
  padding: 28px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--panel);
}

.intro h2 {
  font-size: 35px;
  margin: 0 0 10px;
  line-height: 1;
  color: var(--amber);
}

.intro p {
  color: var(--muted);
  font-size: 14px;
  margin: 0 0 12px;
}

.intro p:last-child {
  margin-bottom: 0;
}

.updated {
  display: inline-block;
  margin-top: 12px;
  padding: 7px 13px;
  border-radius: 999px;
  background: rgba(242, 163, 58, .1);
  border: 1px solid rgba(242, 163, 58, .25);
  color: var(--amber);
  font-size: 12px;
  font-weight: 700;
}

/* SUMMARY */

.summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-top: 25px;
}

.summary-card {
  padding: 22px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16px;
}

.summary-card h3 {
  font-family: Inter, Arial, sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: var(--amber);
  margin: 0 0 9px;
}

.summary-card p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
  margin: 0;
}

/* TERMS */

.terms {
  margin-top: 40px;
}

.terms-heading {
  font-size: 38px;
  margin: 0 0 20px;
  line-height: 1;
}

.term {
  padding: 26px 28px;
  margin-bottom: 15px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 17px;
}

.term h2 {
  font-size: 29px;
  color: var(--amber);
  margin: 0 0 13px;
  line-height: 1.1;
  letter-spacing: .02em;
}

.term p {
  font-size: 14px;
  line-height: 1.8;
  color: var(--muted);
  margin: 0 0 13px;
}

.term p:last-child {
  margin-bottom: 0;
}

.term ul {
  padding-left: 21px;
  margin: 10px 0 15px;
}

.term li {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
  margin-bottom: 9px;
}

.term strong {
  color: var(--cream);
  font-weight: 700;
}

.highlight {
  background: rgba(242, 163, 58, .07);
  border: 1px solid rgba(242, 163, 58, .35);
  border-radius: 14px;
  padding: 20px;
  margin: 18px 0;
}

.highlight strong {
  color: var(--amber);
}

.highlight p {
  margin: 0;
}

/* CONTACT */

.contact {
  margin-top: 35px;
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--panel);
}

.contact h2 {
  font-size: 35px;
  color: var(--amber);
  margin: 0 0 12px;
}

.contact p {
  color: var(--muted);
  font-size: 14px;
  margin: 0 0 15px;
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 20px;
  background: var(--amber);
  color: var(--night);
  border-radius: 999px;
  font-size: 14px;
  font-weight: 700;
}

.contact-link:hover {
  background: #FFC06A;
  color: var(--night);
  text-decoration: none;
}

.contact-link.secondary {
  background: transparent;
  color: var(--cream);
  border: 1px solid var(--field);
}

/* FOOTER */

.foot {
  margin-top: 56px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
  display: flex;
  flex-wrap: wrap;
  gap: 28px 48px;
  align-items: flex-start;
  justify-content: space-between;
}

.foot-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.foot-brand .pour {
  font-size: 44px;
}

.foot-brand .live {
  font-size: 11px;
  letter-spacing: .55em;
}

.foot-brand .live i {
  width: 7px;
  height: 7px;
}

.foot-cols {
  display: flex;
  flex-wrap: wrap;
  gap: 28px 48px;
}

.foot h4 {
  margin: 0 0 8px;
  font-size: 14px;
  color: var(--amber);
}

.foot p,
.foot a {
  margin: 0 0 6px;
  font-size: 15px;
  color: var(--cream);
  text-decoration: none;
  display: block;
}

.foot a:hover {
  color: var(--amber);
}

.legal {
  width: 100%;
  margin-top: 8px;
  font-size: 13px !important;
  color: var(--muted) !important;
}

/* RESPONSIVE QUERIES */

@media(max-width:850px) {
  .summary {
    grid-template-columns: 1fr;
  }
}

@media(max-width:760px) {
  .nav-links {
    gap: 12px;
    font-size: 13px;
  }
  .nav-links a:not(.active):not([href="/book-your-bartender"]) {
    display: none;
  }
  #terms-container {
    padding: 24px 16px 60px;
  }

  .hero {
    gap: 20px;
    padding-bottom: 24px;
  }

  .pour {
    font-size: 72px;
  }

  .pitch h1 {
    font-size: 36px;
  }

  .pitch p {
    font-size: 14px;
  }

  .intro {
    padding: 20px;
    margin-top: 20px;
  }

  .intro h2 {
    font-size: 28px;
  }

  .summary {
    gap: 12px;
  }

  .summary-card {
    padding: 18px;
  }

  .terms {
    margin-top: 28px;
  }

  .terms-heading {
    font-size: 30px;
  }

  .term {
    padding: 20px 18px;
    margin-bottom: 12px;
  }

  .term h2 {
    font-size: 24px;
  }

  .term p,
  .term li {
    font-size: 13.5px;
  }

  .contact {
    padding: 20px;
  }

  .contact h2 {
    font-size: 28px;
  }

  .contact-links {
    flex-direction: column;
  }

  .contact-link {
    width: 100%;
  }

  .foot {
    margin-top: 36px;
    padding-top: 20px;
    gap: 20px;
  }
}
</style>
</head>

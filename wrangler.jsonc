{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pourlive",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "pourlive.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pourlive.com",
      "custom_domain": true
    }
  ]
}
